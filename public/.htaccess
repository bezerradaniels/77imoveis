# 77Imóveis — fallback Apache da Hostinger para arquivos públicos.
# O redirect principal da aplicação Node também está em next.config.js.

RewriteEngine On

# 1) Landing isolada no subdomínio (preserva a query string existente)
RewriteCond %{THE_REQUEST} \s/+captacao-profissionais(?:\.html)?(?:[?\s]) [NC]
RewriteRule ^captacao-profissionais(?:\.html)?/?$ https://lps.77imoveis.com.br/captacao-profissionais/ [R=301,L,NE]

# 2) Forçar HTTPS nas demais URLs
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# 3) URLs amigáveis do export do Next (serve a pasta /rota/index.html)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]

# 4) Página 404 personalizada
ErrorDocument 404 /404.html

# 5) Compressão (deixa o site mais rápido)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# 6) Cache dos arquivos estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# 7) Cabeçalhos de segurança
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
